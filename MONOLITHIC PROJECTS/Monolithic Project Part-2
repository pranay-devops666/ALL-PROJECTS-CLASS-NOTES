To Delete S3 Bucket automation like beow
===============================================

Step 1: Add force_destroy

Update your S3 bucket resource:

resource "aws_s3_bucket" "one" {
  bucket        = "pranay-devopss18-2026-001"
  force_destroy = true
}

Step 2: Use this Jenkins pipeline

pipeline {
    agent any

    environment {
        BUCKET = "pranay-devopss18-2026-001"
        REGION = "us-east-1"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                url: 'https://github.com/pranay-devops666/devops18.git'
            }
        }

        stage('Terraform Init') {
            steps {
                sh 'terraform init'
            }
        }

        stage('Terraform Destroy') {
            steps {
                sh 'terraform destroy -auto-approve || true'
            }
        }

        stage('Delete All Objects and Versions') {
            steps {
                sh '''
                aws s3 rm s3://$BUCKET --recursive

                aws s3api list-object-versions --bucket $BUCKET \
                --query='{Objects: Versions[].{Key:Key,VersionId:VersionId}}' \
                --output=json > versions.json

                if [ -s versions.json ]; then
                  aws s3api delete-objects \
                  --bucket $BUCKET \
                  --delete file://versions.json || true
                fi

                aws s3api list-object-versions --bucket $BUCKET \
                --query='{Objects: DeleteMarkers[].{Key:Key,VersionId:VersionId}}' \
                --output=json > markers.json

                if [ -s markers.json ]; then
                  aws s3api delete-objects \
                  --bucket $BUCKET \
                  --delete file://markers.json || true
                fi
                '''
            }
        }

        stage('Delete Bucket') {
            steps {
                sh '''
                aws s3api delete-bucket \
                --bucket $BUCKET \
                --region $REGION
                '''
            }
        }
    }
}


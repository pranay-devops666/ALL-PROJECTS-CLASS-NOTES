jenkins pipeline to create everything
=========================================

pipeline {
    agent any
    stages {
        stage('Code') {
            steps {
                git branch: 'main', url: 'https://github.com/pranay-devops666/devops18.git'
            }
        }
        stage('Init') {
            steps {
                script {
                    sh 'echo -e "yes\n" | terraform init'
                }
            }
        }
        stage('Plan') {
            steps {
                script {
                    sh 'terraform plan'
                }
            }
        }
        stage('Apply') {
            steps {
                script {
                    sh 'terraform apply --auto-approve'
                }
            }
        }
        stage('Deploy') {
            steps {
                sh 'ansible-playbook -i /opt/ansible/inventory/aws_ec2.yml /var/lib/jenkins/workspace/MyDeployment/ansible/deployment.yml'
            }
        }
    }
}


jenkins pipeline to destroy everything
=========================================

pipeline {
    agent any

    environment {
        AWS_DEFAULT_REGION = 'us-east-1'
        TF_STATE_BUCKET = 'YOUR_BUCKET_NAME'
        TF_STATE_FILE = 'terraform.tfstate'
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'main',
                url: 'https://github.com/pranay-devops666/devops18.git'
            }
        }

        stage('Terraform Init') {
            steps {
                sh '''
                terraform init
                '''
            }
        }

        stage('Terraform Destroy') {
            steps {
                sh '''
                terraform destroy -auto-approve
                '''
            }
        }

        stage('Delete Terraform State File') {
            steps {
                sh '''
                aws s3 rm s3://${TF_STATE_BUCKET}/${TF_STATE_FILE}
                '''
            }
        }

        stage('Delete Remaining Files (if any)') {
            steps {
                sh '''
                aws s3 rm s3://${TF_STATE_BUCKET} --recursive
                '''
            }
        }

        stage('Delete S3 Bucket') {
            steps {
                sh '''
                aws s3api delete-bucket --bucket ${TF_STATE_BUCKET} --region ${AWS_DEFAULT_REGION}
                '''
            }
        }

    }

    post {
        success {
            echo "Infrastructure destroyed successfully."
        }

        failure {
            echo "Destroy pipeline failed."
        }
    }
}


